        [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcLabel ;
            owl:onProperty list:hasContents ],
        [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcLabel_List ;
            owl:onProperty list:hasNext ],
        list:OWLList .

ifc:IfcNormalisedRatioMeasure a owl:Class ;
