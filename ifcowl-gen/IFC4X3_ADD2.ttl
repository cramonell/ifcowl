            owl:onProperty ifc:baseCosts_IfcConstructionResource ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ifc:IfcAppliedValue_List ;
            owl:onProperty ifc:baseCosts_IfcConstructionResource ],
        [ a owl:Restriction ;
