ifc:IfcAppliedValue_EmptyList a owl:Class ;
    rdfs:subClassOf ifc:IfcAppliedValue_List,
        list:EmptyList .

ifc:IfcArcIndex a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty list:hasNext ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty list:hasNext ;
                    owl:someValuesFrom [ a owl:Restriction ;
                            owl:onProperty list:hasNext ;
                            owl:someValuesFrom ifc:IfcPositiveInteger_List ] ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom [ a owl:Restriction ;
                            owl:onClass ifc:IfcPositiveInteger_EmptyList ;
                            owl:onProperty list:hasNext ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
                    owl:onProperty list:hasNext ] ;
            owl:onProperty list:hasNext ],
        ifc:IfcPositiveInteger_List,
        ifc:IfcSegmentIndexSelect .

ifc:IfcAreaDensityMeasure a owl:Class ;
    rdfs:subClassOf express:REAL,
        ifc:IfcDerivedMeasureValue .

