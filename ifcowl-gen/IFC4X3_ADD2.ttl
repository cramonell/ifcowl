            owl:unionOf ( ifc:IfcConstructionEquipmentResource ifc:IfcConstructionMaterialResource ifc:IfcConstructionProductResource ifc:IfcCrewResource ifc:IfcLaborResource ifc:IfcSubContractResource ) ],
