        ifc:IfcBoundingBox,
        ifc:IfcCartesianPointList,
        ifc:IfcCartesianTransformationOperator,
        ifc:IfcCsgPrimitive3D,
        ifc:IfcCurve,
        ifc:IfcFaceBasedSurfaceModel,
        ifc:IfcFillAreaStyleHatching,
