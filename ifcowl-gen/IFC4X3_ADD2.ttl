ifc:IfcAlignmentCant a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ifc:IfcPositiveLengthMeasure ;
            owl:onProperty ifc:railHeadDistance_IfcAlignmentCant ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcPositiveLengthMeasure ;
            owl:onProperty ifc:railHeadDistance_IfcAlignmentCant ],
        ifc:IfcLinearElement ;
    owl:disjointWith ifc:IfcAlignmentHorizontal,
        ifc:IfcAlignmentSegment,
        ifc:IfcAlignmentVertical .

ifc:IfcAlignmentSegment a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcAlignmentParameterSegment ;
            owl:onProperty ifc:designParameters_IfcAlignmentSegment ],
        [ a owl:Restriction ;
            owl:onClass ifc:IfcAlignmentParameterSegment ;
            owl:onProperty ifc:designParameters_IfcAlignmentSegment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ifc:IfcLinearElement ;
    owl:disjointWith ifc:IfcAlignmentCant,
        ifc:IfcAlignmentHorizontal,
        ifc:IfcAlignmentVertical .

ifc:IfcBinary a owl:Class ;
    rdfs:subClassOf express:BINARY,
        ifc:IfcSimpleValue .

ifc:IfcBoundaryCurve a owl:Class ;
    rdfs:subClassOf ifc:IfcCompositeCurveOnSurface .

ifc:IfcCartesianPointList2D a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ifc:IfcLabel_List ;
            owl:onProperty ifc:tagList_IfcCartesianPointList2D ],
        [ a owl:Restriction ;
            owl:onClass ifc:IfcLengthMeasure_List_List ;
            owl:onProperty ifc:coordList_IfcCartesianPointList2D ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:onProperty list:hasNext ;
                    owl:someValuesFrom ifc:IfcLengthMeasure_List_List ] ;
            owl:onProperty ifc:coordList_IfcCartesianPointList2D ],
        [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcLengthMeasure_List_List ;
            owl:onProperty ifc:coordList_IfcCartesianPointList2D ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:onProperty list:hasNext ;
                    owl:someValuesFrom ifc:IfcLabel_List ] ;
            owl:onProperty ifc:tagList_IfcCartesianPointList2D ],
        [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcLabel_List ;
            owl:onProperty ifc:tagList_IfcCartesianPointList2D ],
        ifc:IfcCartesianPointList ;
    owl:disjointWith ifc:IfcCartesianPointList3D .

ifc:IfcCartesianTransformationOperator3D a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
