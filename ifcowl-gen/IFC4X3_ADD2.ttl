    rdfs:subClassOf ifc:IfcActorRole_List,
        list:EmptyList .

ifc:IfcAddress_EmptyList a owl:Class ;
    rdfs:subClassOf ifc:IfcAddress_List,
        list:EmptyList .

ifc:IfcAdvancedFace a owl:Class ;
    rdfs:subClassOf ifc:IfcFaceSurface .

ifc:IfcAmountOfSubstanceMeasure a owl:Class ;
    rdfs:subClassOf express:REAL,
        ifc:IfcMeasureValue .

ifc:IfcAngularVelocityMeasure a owl:Class ;
    rdfs:subClassOf express:REAL,
