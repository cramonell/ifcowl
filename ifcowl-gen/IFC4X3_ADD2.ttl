            owl:onProperty ifc:longName_IfcSpaceType ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ifc:IfcLabel ;
            owl:onProperty ifc:longName_IfcSpaceType ],
        [ a owl:Restriction ;
