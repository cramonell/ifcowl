            owl:onProperty ifc:factorZ_IfcMapConversionScaled ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        ifc:IfcMapConversion .

ifc:IfcMassMeasure a owl:Class ;
    rdfs:subClassOf express:REAL,
        ifc:IfcMeasureValue .

ifc:IfcMaterialUsageDefinition a owl:Class ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( ifc:IfcMaterialLayerSetUsage ifc:IfcMaterialProfileSetUsage ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcRelAssociatesMaterial ;
            owl:onProperty ifc:associatedTo_IfcMaterialUsageDefinition ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ifc:IfcRelAssociatesMaterial ;
            owl:onProperty ifc:associatedTo_IfcMaterialUsageDefinition ],
        ifc:IfcMaterialSelect .

ifc:IfcNumericMeasure a owl:Class ;
    rdfs:subClassOf express:NUMBER,
        ifc:IfcMeasureValue .

ifc:IfcPile a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcPileConstructionEnum ;
            owl:onProperty ifc:constructionType_IfcPile ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ifc:IfcPileTypeEnum ;
            owl:onProperty ifc:predefinedType_IfcPile ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ifc:IfcPileConstructionEnum ;
            owl:onProperty ifc:constructionType_IfcPile ],
        [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcPileTypeEnum ;
            owl:onProperty ifc:predefinedType_IfcPile ],
        ifc:IfcDeepFoundation ;
    owl:disjointWith ifc:IfcCaissonFoundation .

ifc:IfcPolyLoop a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:onProperty list:hasNext ;
                    owl:someValuesFrom [ a owl:Restriction ;
                            owl:onProperty list:hasNext ;
                            owl:someValuesFrom [ a owl:Restriction ;
                                    owl:onProperty list:hasNext ;
                                    owl:someValuesFrom ifc:IfcCartesianPoint_List ] ] ] ;
            owl:onProperty ifc:polygon_IfcPolyLoop ],
        [ a owl:Restriction ;
            owl:onClass ifc:IfcCartesianPoint_List ;
            owl:onProperty ifc:polygon_IfcPolyLoop ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcCartesianPoint_List ;
            owl:onProperty ifc:polygon_IfcPolyLoop ],
        ifc:IfcLoop ;
    owl:disjointWith ifc:IfcEdgeLoop,
        ifc:IfcVertexLoop .

ifc:IfcPolygonalBoundedHalfSpace a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcBoundedCurve ;
            owl:onProperty ifc:polygonalBoundary_IfcPolygonalBoundedHalfSpace ],
        [ a owl:Restriction ;
