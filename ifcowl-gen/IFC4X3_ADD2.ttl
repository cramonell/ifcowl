        ifc:IfcGeometricSet,
        ifc:IfcHalfSpaceSolid,
        ifc:IfcLightSource,
        ifc:IfcPlacement,
        ifc:IfcPlanarExtent,
        ifc:IfcPoint,
        ifc:IfcSectionedSpine,
        ifc:IfcSegment,
        ifc:IfcShellBasedSurfaceModel,
        ifc:IfcSolidModel,
        ifc:IfcSurface,
        ifc:IfcTessellatedItem,
        ifc:IfcTextLiteral,
        ifc:IfcVector .

