        [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcTableRow_List ;
            owl:onProperty ifc:rows_IfcTable ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:onProperty list:hasNext ;
                    owl:someValuesFrom ifc:IfcTableRow_List ] ;
            owl:onProperty ifc:rows_IfcTable ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
