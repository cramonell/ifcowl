        owl:ObjectProperty ;
    rdfs:label "YDim" ;
    rdfs:domain ifc:IfcTrapeziumProfileDef ;
    rdfs:range ifc:IfcPositiveLengthMeasure .

ifc:yLength_IfcBlock a owl:FunctionalProperty,
