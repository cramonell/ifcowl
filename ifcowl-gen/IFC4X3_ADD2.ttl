ifc:IfcMapConversionScaled a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass ifc:IfcReal ;
            owl:onProperty ifc:factorX_IfcMapConversionScaled ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:allValuesFrom ifc:IfcReal ;
            owl:onProperty ifc:factorZ_IfcMapConversionScaled ],
        [ a owl:Restriction ;
