ifc:IfcPump a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass ifc:IfcPumpTypeEnum ;
            owl:onProperty ifc:predefinedType_IfcPump ],
        [ a owl:Restriction ;
